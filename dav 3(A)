# Univariate Analysis Function
def univariate_analysis(df, columns):
    stats = {}
    for col in columns:
        # Ensure the column exists in the DataFrame before attempting to calculate stats
        if col in df.columns:
            # Filter out zeros or NaNs from relevant columns if they represent missing data
            # For example, Glucose, BloodPressure, SkinThickness, Insulin, BMI often have 0 as missing data
            cleaned_col = df[col].replace(0, np.nan).dropna()
            if not cleaned_col.empty:
                stats[col] = {
                    "Mean": np.mean(cleaned_col),
                    "Median": np.median(cleaned_col),
                    "Mode": cleaned_col.mode()[0] if not cleaned_col.mode().empty else np.nan,
                    "Variance": np.var(cleaned_col, ddof=1),
                    "Standard Deviation": np.std(cleaned_col, ddof=1),
                    "Skewness": skew(cleaned_col),
                    "Kurtosis": kurtosis(cleaned_col)
                }
            else:
                stats[col] = {stat: np.nan for stat in ["Mean", "Median", "Mode", "Variance", "Standard Deviation", "Skewness", "Kurtosis"]}
        else:
            print(f"Warning: Column '{col}' not found in the DataFrame.")
            stats[col] = {stat: np.nan for stat in ["Mean", "Median", "Mode", "Variance", "Standard Deviation", "Skewness", "Kurtosis"]}
    return pd.DataFrame(stats).T

# Perform Univariate Analysis
uci_stats = univariate_analysis(uci_diabetes, numerical_columns)
pima_stats = univariate_analysis(pima_diabetes, numerical_columns)

# Display Results
print("\nUCI Diabetes Dataset Statistics:")
print(uci_stats)
print("\nPima Indians Diabetes Dataset Statistics:")
print(pima_stats)
