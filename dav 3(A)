    "BloodPressure": np.random.randint(50, 120, 100),
    "SkinThickness": np.random.randint(10, 60, 100),
    "Insulin": np.random.randint(0, 850, 100),
    "BMI": np.random.uniform(15.0, 50.0, 100),
    "DiabetesPedigreeFunction": np.random.uniform(0.1, 2.5, 100),
    "Age": np.random.randint(20, 80, 100),
    "Outcome": np.random.randint(0, 2, 100)
}
uci_diabetes = pd.DataFrame(uci_data)

