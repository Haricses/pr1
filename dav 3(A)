import pandas as pd
import numpy as np
from scipy.stats import skew, kurtosis

# Define Relevant Numerical Columns to create sample data
numerical_columns = ["Glucose", "BloodPressure", "SkinThickness", "Insulin", "BMI",
"DiabetesPedigreeFunction", "Age"]

# Creating sample DataFrames for demonstration purposes
# Sample data for UCI Diabetes Dataset
uci_data = {
    "Pregnancies": np.random.randint(0, 17, 100),
